# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
.next/
coverage/

# Environment / secrets (never commit)
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# Prisma local DBs
**/prisma/*.db
**/prisma/*.db-journal

# Logs & temp
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.out
*.tmp
tmp/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.sw?
*.suo

# Local AI / agent tooling (not runtime)
.gstack/
.ai-worktrees/
.antigravitycli/
.conductor/
**/.agents/
**/skills-lock.json

# Backups / dumps (may contain PII)
*.dump
*.sql.bak
cadt_events_full_*.sql
cadt_events_full_*.dump

# Test / coverage leftovers
coverage/
.nyc_output/

# E2E artifacts (keep specs; ignore run output)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/screenshots/
e2e/screenshots-*/
e2e/.env.test
