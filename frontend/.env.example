# Clerk Authentication
# Get your key from https://dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=your_vite_clerk_publishable_key_here

# Backend API (user frontend) - must match backend PORT
VITE_API_URL=http://localhost:4000/api

VITE_TELEGRAM_BOT_USERNAME="your_telegram_bot_username_here"

# Admin app URL (used for auto-redirect when user has admin role)
VITE_ADMIN_URL=http://localhost:3000
