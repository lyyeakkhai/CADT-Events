# Clerk publishable key (safe to expose in the browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Backend API base URL (include /api)
VITE_API_URL=http://localhost:4000/api

# Telegram bot username without @ (optional)
VITE_TELEGRAM_BOT_USERNAME=

# Admin app URL (production Vercel admin origin — no trailing slash)
# Required for "Open Admin Portal" and auto-redirect when role is ADMIN
VITE_ADMIN_URL=https://cadt-events-ytaz.vercel.app

# Optional: same list as backend ADMIN_EMAILS (UI admin detection)
# VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh
