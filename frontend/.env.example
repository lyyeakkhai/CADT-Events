# ── Local development ────────────────────────────────────────────────────────
# Clerk publishable key (safe to expose in the browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Backend API base URL (include /api)
VITE_API_URL=http://localhost:4000/api

# Telegram bot username without @ (optional)
VITE_TELEGRAM_BOT_USERNAME=

# Local dual-port only: where admin Vite runs (default http://localhost:3000).
# Production unified deploy ignores this and always uses same-origin /admin.
VITE_ADMIN_URL=http://localhost:3000

# Optional: teacher emails (merged with built-in defaults; does not replace them)
VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh

# ── Production (ONE Vercel project, repo root) ───────────────────────────────
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# VITE_API_URL=https://cadt-events.onrender.com/api
# VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh
# (no second Vercel admin host — admin is https://your-site.vercel.app/admin)
#
# Note: VITE_* is baked in at build time — change env → Redeploy on Vercel.
