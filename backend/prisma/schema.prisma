datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  STUDENT
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// =========================================================================
// MODELS (aligned with current backend controllers & admin frontend)
// =========================================================================

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]
  events   Event[]   // Events created/administered by this user

  @@map("users")
}

model Venue {
  id       String  @id @default(uuid())
  name     String
  address  String?
  capacity Int?
  events   Event[]

  @@map("venues")
}

model Event {
  id              String       @id @default(uuid())
  title           String
  description     String?      @db.Text
  eventType       String?      @map("event_type")
  status          EventStatus  @default(DRAFT)
  startTimestamp  DateTime     @map("start_timestamp")
  endTimestamp    DateTime     @map("end_timestamp")
  location        String?
  coverImageUrl   String?      @map("cover_image_url")
  creditValue     Int          @default(0) @map("credit_value")
  isFeatured      Boolean      @default(false) @map("is_featured")
  capacity        Int?
  adminId         String?      @map("admin_id")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  admin    User?     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  venue    Venue?    @relation(fields: [venueId], references: [id])
  venueId  String?   @map("venue_id")
  bookings Booking[]

  @@index([startTimestamp, endTimestamp])
  @@map("events")
}

model Booking {
  id                 String        @id @default(uuid())
  bookingReferenceId String        @unique @map("booking_reference_id")
  userId             String        @map("user_id")
  eventId            String        @map("event_id")
  eventSeatId        String?       @map("event_seat_id")
  status             BookingStatus @default(CONFIRMED)
  qrCode             String?       @map("qr_code")
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

// Legacy / future tables kept for compatibility (can be expanded in later phases)
model Speaker {
  id              String @id @default(uuid())
  name            String
  titleRole       String?
  organization    String?
  bio             String? @db.Text
  profileImageUrl String? @map("profile_image_url")

  @@map("speakers")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  @@map("categories")
}