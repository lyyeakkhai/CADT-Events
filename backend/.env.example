NODE_ENV=development
PORT=4000

# Supabase Postgres — Transaction pooler (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Supabase Postgres — Session/direct (migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Clerk — https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Clerk webhook signing secret (Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx

# Comma-separated emails that get publicMetadata.role=ADMIN (teachers / organizers)
# Required for demos: list every teacher who should create events
ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh,teacher@cadt.edu.kh

# Cloudinary (optional for image uploads)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram bot (optional for notifications)
TELEGRAM_BOT_TOKEN=

# Optional Redis for BullMQ queues (not required for basic demo)
# REDIS_URL=redis://localhost:6379

# Frontend URLs for CORS (required in production — exact origins, no trailing slash)
# Local dual-port:
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3000
# Production (unified web — same origin for student + /admin):
# FRONTEND_URL=https://cadt-events.vercel.app
# ADMIN_URL=https://cadt-events.vercel.app

# Public student web URL (https) for Telegram inline buttons
PUBLIC_WEB_URL=http://localhost:5173
# PUBLIC_WEB_URL=https://cadt-events.vercel.app
