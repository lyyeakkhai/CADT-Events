# ── Local development ────────────────────────────────────────────────────────
# Clerk publishable key (same Clerk application as student frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Backend API base URL (include /api)
VITE_API_URL=http://localhost:4000/api

# Student app origin — local dual-port only (production uses same-origin /)
VITE_USER_FRONTEND_URL=http://localhost:5173

# Teacher/admin emails (merged with built-in defaults; does not replace them)
VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh

# ── Production (same Vercel project as student; built via scripts/build-web.sh) ─
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...   # SAME key as student
# VITE_API_URL=https://cadt-events.onrender.com/api
# VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh
# VITE_USER_FRONTEND_URL is optional in production (defaults to /)
#
# Note: production build sets ADMIN_BASE_PATH=/admin/ in scripts/build-web.sh
