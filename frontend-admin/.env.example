# ── Local development ────────────────────────────────────────────────────────
# Clerk publishable key (same Clerk application as student frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Backend API base URL (include /api)
VITE_API_URL=http://localhost:4000/api

# Student app origin — used only to send confirmed non-admins to the student site.
# Never used to bounce unauthenticated users to student login (that causes loops).
VITE_USER_FRONTEND_URL=http://localhost:5173

# Teacher/admin emails (merged with built-in defaults; does not replace them)
VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh

# ── Production (Admin Vercel project) ────────────────────────────────────────
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...   # SAME key as student Vercel
# VITE_API_URL=https://cadt-events.onrender.com/api
# VITE_USER_FRONTEND_URL=https://cadt-events.vercel.app
# VITE_ADMIN_EMAILS=yeakkhai.ly@student.cadt.edu.kh
#
# Note: VITE_* is baked in at build time — change env → Redeploy on Vercel.
# Clerk sessions are per-domain: signing in on student does not log you into admin.
